# === Admin login (there is no setup or sign-up page) ===
# Created on the first start of an EMPTY database, then ignored. Change the password later in
# Settings, or with: npm run admin:reset-password -- --email <email>
# Or create it from the command line instead: npm run admin:create -- --email <email>
LEAD_DESK_ADMIN_EMAIL=admin@gmail.com
LEAD_DESK_ADMIN_PASSWORD=admin@12345678
LEAD_DESK_ADMIN_NAME=Admin
# LEAD_DESK_ADMIN_TIMEZONE=Asia/Kolkata
# LEAD_DESK_ADMIN_COUNTRY=IN

# === Data encryption (AES-256-GCM key, 32 bytes base64) ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same value when moving between PC, cloud and VPS, or the saved AI key cannot be read.
LEAD_DESK_DATA_KEY=

# === Model key (optional at boot; also settable via the AI screen) ===
XAI_API_KEY=

# === Networking / cookies ===
# Local PC: false (http://127.0.0.1). Cloud or VPS over https: true.
LEAD_DESK_COOKIE_SECURE=false
LEAD_DESK_EXTENSION_ORIGIN=chrome-extension://hppcpamgnlipjhhjaidgikobjoonpaah
LEAD_DESK_AI_EXTRA_HOSTS=
# Address the server listens on. 127.0.0.1 on a PC/VPS; Render sets 0.0.0.0 (render.yaml).
# HOST=127.0.0.1
# Behind Render / Cloudflare the client address comes from X-Forwarded-For.
# TRUST_PROXY=true
# Public dashboard address (e.g. https://leaddesk.pages.dev).
# LEAD_DESK_PUBLIC_URL=

# === Database ===
# Leave all of these empty to use local SQLite files in apps/server/data/ (PC or VPS).
# Free cloud setup (Turso), see docs/deploy-free.md:
# DATABASE_URL=libsql://leaddesk-main-<org>.turso.io
# CONTROL_DATABASE_URL=libsql://leaddesk-control-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso group token>
# Needed to create one Turso database per client account:
# TURSO_ORG=<org slug>
# TURSO_API_TOKEN=<turso platform api token>
# TURSO_GROUP=default
# TURSO_GROUP_AUTH_TOKEN=   (only if client databases use a different token than DATABASE_AUTH_TOKEN)

# === Emergency brakes ===
LEAD_DESK_SENDING_ENABLED=true
LEAD_DESK_AI_ENABLED=true
