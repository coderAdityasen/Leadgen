{
  "name": "@leaddesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:libsql": "node scripts/test-libsql.mjs",
    "db:to-turso": "tsx scripts/transfer.ts to-turso",
    "db:to-local": "tsx scripts/transfer.ts to-local",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:reset-password": "tsx scripts/admin.ts reset-password"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@leaddesk/shared": "*",
    "@libsql/client": "^0.18.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "libphonenumber-js": "^1.13.15",
    "openai": "^7.47.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
